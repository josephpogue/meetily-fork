#!/bin/bash
# Claude stand-in for the test Mac, as the Zoom stand-in fakes Zoom. It holds no login, makes no network call and
# reads no credentials. Its only job is to let Meetily's assistant session open (core.rs `open_session` stops when
# `claude --version` fails), so the Zoom window capture runs. Every answer is canned: assistant output is not tested here.
# It answers `claude -p ... --output-format stream-json` with the two lines the app reads (claude_cli.rs `parse_line`):
# a system/init line carrying the session id and a result line, whose text fits the lane that asked (by its system prompt).
set -u
[ "${1:-}" = "--version" ] && { echo "0.0.0 (Claude stand-in, test Mac)"; exit 0; }

session="" resume="" fork=0 system="" stdin_json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) session="${2:-}"; shift ;;
    --resume) resume="${2:-}"; shift ;;
    --fork-session) fork=1 ;;
    --append-system-prompt) system="${2:-}"; shift ;;
    --input-format) [ "${2:-}" = "stream-json" ] && stdin_json=1; shift ;;
  esac
  shift
done
# A turn with pictures sends them as one stream-json line on stdin: read it so the app's write never hits a closed pipe.
[ "$stdin_json" = 1 ] && cat >/dev/null

if [ -z "$session" ]; then
  if [ -n "$resume" ] && [ "$fork" = 0 ]; then session="$resume"; else session=$(uuidgen | tr '[:upper:]' '[:lower:]'); fi
fi

case "$system" in
  *"=== SLUG ==="*) text=$'=== SLUG ===\ntest-mac-canned-note\n=== NOTE ===\n## Summary\n\nCanned note from the test Mac Claude stand-in.' ;; # note.rs parse_note
  *"ASK:"*) text="NONE" ;;  # ask_list.rs parse: an empty gap list
  *) text="SKIP" ;;         # card.rs parse: answer lanes render nothing; trunk and forks only need a session id
esac

json() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; printf '"%s"' "$s"; }
printf '{"type":"system","subtype":"init","session_id":%s}\n' "$(json "$session")"
printf '{"type":"result","subtype":"success","is_error":false,"result":%s,"session_id":%s}\n' "$(json "$text")" "$(json "$session")"
